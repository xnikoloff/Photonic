<div class="container-fluid" style="background:#f7f7f7;">
    <div class="row">
        <dvi class="col-12">
            <h2></h2>
        </dvi>
    </div>
    <div class="row">
        <div class="col-lg-8 col-sm-12 mx-auto text-center mt-3">x
            <form asp-action="Create" method="post" id="gift-card-template-form">
                <div class="certificate-wrap" style="background:#f7f7f7;font-family:'Montserrat',sans-serif;display:flex;justify-content:center;align-items:center;min-height:100vh;padding:20px 40px;box-sizing:border-box;margin:0;">
    
                    <div class="certificate" style="width:1000px;max-width:100%;box-shadow:0 15px 40px rgba(0,0,0,.12);padding:90px 100px 40px 100px;position:relative;background:#dae0e3;box-sizing:border-box;">

                        <div class="header" style="text-align:center;margin-bottom:60px;position:relative;z-index:2;">
                            <span class="small-title" style="text-transform:uppercase;letter-spacing:6px;color:#627582;font-size:13px;">
                                Подаръчен ваучер
                            </span>

                            <h1 class="certificate-logo" style="font-family:'Cormorant Garamond',serif;font-size:62px;font-weight:600;color:#222;margin:15px 0;">
                                <img src="~/img/icons/icon-1.png" alt="logo" />
                            </h1>
                        </div>

                        <div class="content" style="position:relative;z-index:2;">

                            <p class="presented" style="text-align:center;color:#777;letter-spacing:1px;margin-top:100px;margin-bottom:20px;font-size:24px;">
                                Този ваучер е създаден специално за
                            </p>

                            <div class="recipient" style="text-align:center;font-family:'Cormorant Garamond',serif;font-size:56px;font-weight:bold;color:#111;border-bottom:2px solid #627582;display:block;width:100%;padding-bottom:12px;margin-bottom:60px;box-sizing:border-box;">
                                <input asp-for="GiftCard.Receiver" class="form-control" style="background:#d0d5d9;font-weight:bold;text-align:center;color:#222;border:none;border-radius:5px" />
                            </div>

                            <div class="details">

                                <div class="item">
                                    <span class="label" style="display:block;color:#627582;text-transform:uppercase;letter-spacing:1px;font-size:11px;margin-bottom:12px;">
                                        Фотосесия
                                    </span>
                                    <span class="value" style="font-size:22px;color:#222;font-weight:500;">
                                        <select asp-for="GiftCard.PhotoShootType" asp-items="Html.GetEnumSelectList<PhotoShootType>()" class="form-control" style="background:#d0d5d9;font-weight:bold;text-align:center;color:#222;border:none;border-radius:5px">
                                            <option selected="selected" value="">Фотосесия</option>
                                        </select>
                                    </span>
                                </div>

                                <div class="item mt-5">
                                    <span class="label" style="display:block;color:#627582;text-transform:uppercase;letter-spacing:1px;font-size:11px;margin-bottom:12px;">
                                        Валиден до
                                    </span>
                                    <span class="value" style="font-size:22px;color:#222;font-weight:500;">
                                        --- г   
                                    </span>
                                    <h6 class="remove remove-valid-until-description" style="font-style:italic">/попълва се автоматично след изтегляне/</h6>
                                </div>
                                <div class="item mt-5">
                                    <div class="certificate-number" style="font-size:13px;color:#888;letter-spacing:2px;">
                                        #CERTIFICATE NUMBER
                                    </div>
                                </div>

                            </div>
                        </div>  

                        <div class="footer" style="display:flex;justify-content:space-between;align-items:flex-end;position:relative;z-index:2;text-center">

                            <div class="signature" style="width:240px;margin:0 auto">
                                <span class="contacts" style="font-size:14px;color:#627582;">
                                    <b>PHOTONIC.bg</b>| +359 878 131828
                                </span>
                            </div>

                        </div>
                    </div>
                </div>
            </form>
        </div>
        <div class="col-lg-4 col-sm-12 col-summary-section mt-5">
            <div class="summary-section-photoshoot-type">
                <p class="summary-section-icon text-primary"><i class="fa-solid fa-camera fa-lg"></i> <b>Фотосесия</b>: <span class="summary-data text-dark" id="summary-photoshoot-type">Абитуриентски бал Extra</span></p>
            </div>
            <hr />
            <div class="summary-section-location">
                <p class="text-primary" id="name-summary"><i class="fa-solid fa-user fa-lg"></i> <b>Получател</b>: <span class="text-dark" id="name-summary-text"></span></p>
            </div>
            <hr />
            <div class="summary-section-datetime">
                <p class="text-primary" id="datetime-summary"><i class="fa-solid fa-calendar-days fa-lg"></i> <b>Валиден до</b>: <span class="summary-data text-dark" id="summary-date">@DateTime.Now.AddYears(1).ToString("dd.MM.yyyy") г</span><span class="summary-time" id="summary-time"></span></p>
            </div>
            <hr />
            <div class="summary-section-price">
                <p class="text-primary text-price"><b><span style="font-size:1.6rem">€</span> ЦЕНА</b></p>
                <p class="text-price"><span class="text-dark" id="price-summary">-</span> / <span class="text-dark" id="price-summary-euro">-</span></p>
            </div>
            <div class="summary-section-submit-button mt-5">
                <button type="submit" class="btn btn-primary btn-lg text-white btn-submit" style="width: 100%">ПОРЪЧАЙ</button>
                </div>
        </div>
    </div>
</div>

<style>
    .col-summary-section{
        background: #fff;
        padding: 0 40px;
        padding-top: 35px;
        border-radius: 10px;
        max-height: 460px;
    }

    .info-text{
        font-size: 1.2rem
    }

    @@media only screen and (max-width: 995px) {

        .certificate-wrap{
            padding: 10px !important;
        }

        .certificate{
            padding: 40px 20px !important;
        }

        .label{
            font-size: 9px !important;
        }

        .value, .remove-valid-until-description, #GiftCard_PhotoShootType {
            font-size: 10px !important;
        }

        .signature{
            width: 150px !important;
        }

        .contacts{
            font-size: 8px !important;
        }

        .certificate-number {
            font-size: 8px !important;
        }

        .certificate-logo img {
            width: 150px;
        }

        .presented{
            font-size: 10px !important;
        }
    }
</style>

<script>
    $("#GiftCard_Receiver").change(function(){
        console.log($(this).text())
        $("#name-summary-text").html($(this).val());
    })
</script>