<div class="container-fluid" style="background:#f7f7f7;">
    <div class="row">
        <dvi class="col-12">
            <h2></h2>
        </dvi>
    </div>
    <div class="row">
        <div class="col-lg-8 col-sm-12 mx-auto text-center mt-3">
            <form asp-action="Create" method="post" id="gift-card-template-form">
                <div class="certificate-wrap" style="background:#f7f7f7;font-family:'Montserrat',sans-serif;display:flex;justify-content:center;align-items:center;min-height:100vh;padding:20px 40px;box-sizing:border-box;margin:0;">
    
                    <div class="certificate" style="width:1000px;max-width:100%;box-shadow:0 15px 40px rgba(0,0,0,.12);padding:90px 100px 40px 100px;position:relative;background:#dae0e3;box-sizing:border-box;">

                        <div class="header" style="text-align:center;margin-bottom:60px;position:relative;z-index:2;">
                            <span class="small-title" style="text-transform:uppercase;letter-spacing:6px;color:#627582;font-size:13px;">
                                Подаръчен ваучер
                            </span>

                            <h1 class="certificate-logo" style="font-family:'Cormorant Garamond',serif;font-size:62px;font-weight:600;color:#222;margin:15px 0;">
                                <img src="~/img/icons/icon-1.png" alt="logo" />
                            </h1>
                        </div>

                        <div class="content" style="position:relative;z-index:2;">

                            <p class="presented" style="text-align:center;color:#777;letter-spacing:1px;margin-top:100px;margin-bottom:20px;font-size:24px;">
                                Този ваучер е създаден специално за
                            </p>

                            <div class="recipient" style="text-align:center;font-family:'Cormorant Garamond',serif;font-size:56px;font-weight:bold;color:#111;border-bottom:2px solid #627582;display:block;width:100%;padding-bottom:12px;margin-bottom:60px;box-sizing:border-box;">
                                <input asp-for="GiftCard.Receiver" class="form-control" style="background:#d0d5d9;font-weight:bold;text-align:center;color:#222;border:none;border-radius:5px" />
                            </div>

                            <div class="details">

                                <div class="item">
                                    <span class="label" style="display:block;color:#627582;text-transform:uppercase;letter-spacing:1px;font-size:11px;margin-bottom:12px;">
                                        Фотосесия
                                    </span>
                                    <span class="value" style="font-size:22px;color:#222;font-weight:500;">
                                        <select asp-for="GiftCard.PhotoShootType" 
                                        asp-items="Html.GetEnumSelectList<PhotoShootType>()
                                        .Where(ph => 
                                               int.Parse(ph.Value) == (int)PhotoShootType.Personal
                                            || int.Parse(ph.Value) == (int)PhotoShootType.PersonalPlus
                                            || int.Parse(ph.Value) == (int)PhotoShootType.PersonalExtra
                                            || int.Parse(ph.Value) == (int)PhotoShootType.Family
                                            || int.Parse(ph.Value) == (int)PhotoShootType.FamilyPlus
                                            || int.Parse(ph.Value) == (int)PhotoShootType.FamilyExtra
                                            || int.Parse(ph.Value) == (int)PhotoShootType.Automotive 
                                            || int.Parse(ph.Value) == (int)PhotoShootType.AutomotivePlus 
                                            || int.Parse(ph.Value) == (int)PhotoShootType.AutomotiveExtra)
                                        .OrderByDescending(ph => ph.Text)" 
                                        class="form-control" style="background:#d0d5d9;font-weight:bold;text-align:center;color:#222;border:none;border-radius:5px">
                                            <option selected="selected" value="">Фотосесия</option>
                                        </select>
                                    </span>
                                </div>

                                <div class="item item-valid-until" style="margin-top: 40px;">
                                    <span class="label" style="display:block;color:#627582;text-transform:uppercase;letter-spacing:1px;font-size:11px;margin-bottom:12px;">
                                        Валиден до
                                    </span>
                                    <span class="value" style="font-size:22px;color:#222;font-weight:500;">
                                        @DateTime.Now.AddYears(1).ToString("dd.MM.yyyy")    
                                    </span>
                                </div>
                                <div class="item item-cert-number" style="margin-top:40px">
                                    <div class="certificate-number" style="font-size:13px;color:#888;letter-spacing:2px;">
                                        #CERTIFICATE NUMBER
                                    </div>
                                </div>

                            </div>
                        </div>  

                        <div class="footer text-center" style="display:flex;justify-content:space-between;align-items:flex-end;position:relative;z-index:2;">

                            <div class="signature" style="width:240px;margin:0 auto">
                                <span class="contacts" style="font-size:14px;color:#627582;">
                                    <b>PHOTONIC.bg</b>| +359 878 131828
                                </span>
                            </div>

                        </div>
                    </div>
                </div>
            </form>
        </div>
        <div class="col-lg-4 col-sm-12 col-summary-section mt-lg-5">
            <div class="summary-section-photoshoot-type">
                    <p class="summary-section-icon text-primary"><i class="fa-solid fa-camera fa-lg"></i> <b>Фотосесия</b>: <span class="summary-data text-dark" id="summary-photoshoot-type"></span></p>
            </div>
            <hr />
            <div class="summary-section-location">
                <p class="text-primary" id="name-summary"><i class="fa-solid fa-user fa-lg"></i> <b>Получател</b>: <span class="text-dark" id="name-summary-text"></span></p>
            </div>
            <hr />
            <div class="summary-section-datetime">
                <p class="text-primary" id="datetime-summary"><i class="fa-solid fa-calendar-days fa-lg"></i> <b>Валиден до</b>: <span class="summary-data text-dark" id="summary-date">@DateTime.Now.AddYears(1).ToString("dd.MM.yyyy") г</span><span class="summary-time" id="summary-time"></span></p>
            </div>
            <hr />
            <div class="summary-section-price">
                <p class="text-primary text-price"><b> ЦЕНА</b> <span class="text-price"><span class="text-dark" id="price-summary">-</span></span> <a target="_blank" asp-controller="Home" asp-action="Pricing" class="text-secondary pricing-link"><i>ВИЖ ЦЕНОРАЗПИС</i></a></p>
                
            </div>
            <div class="summary-section-submit-button mt-3">
                <button type="submit" form="gift-card-template-form" class="btn btn-primary btn-lg text-white btn-submit" style="width: 100%">ПОРЪЧАЙ</button>
            </div>
            <div class="summary-section-payment-info mt-5"> 
                <hr />
                <h4 class="mt-3">🎁 Подари фотосесия, подари спомен!</h4>
                <p class="mt-3">❤️ Изненадай любим човек с подаръчен ваучер за фотосесия от Photonic. Избери подходящата фотосесия, поръчай ваучера онлайн и подари едно незабравимо преживяване, което ще остане завинаги в снимки.</p>
            </div>
            <div>
                <h4>Какво включва ваучерът?</h4>
                <div>
                    <p>📸 <b>Фотосесия на предварително избрана локация</b></p>
                    <p>Изберете мястото, което най-добре подхожда на вас и повода.</p>
                </div>

                <div>
                    <p>⏱️ <b>Продължителност около 1 час</b></p>
                    <p>Достатъчно време за спокойна фотосесия без излишно бързане.</p>
                </div>

                <div>
                    <p>✨ <b>Без лимит на снимките</b></p>
                    <p>Получавате всички успешно заснети и обработени снимки от фотосесията.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .col-summary-section{
        background: #fff;
        padding: 0 40px;
        padding-top: 35px;
        border-radius: 10px;
        max-height: 800px;
        overflow: scroll;
    }

    .info-text{
        font-size: 1.2rem
    }

    .text-price {
        margin-top: -10px;
        font-size: 2rem;
        font-weight: bold
    }

    .pricing-link{
        font-size: 1rem;
    }

    @@media only screen and (max-width: 995px) {

        .certificate-wrap{
            padding: 0 0 !important;
            min-height: unset !important;
        }

        .certificate{
            padding: 30px 10px !important;
        }

        .label{
            font-size: 9px !important;
        }

        .value, .remove-valid-until-description, #GiftCard_PhotoShootType {
            font-size: 10px !important;
        }

        .signature{
            width: 150px !important;
        }

        .contacts{
            font-size: 8px !important;
        }

        .certificate-number {
            font-size: 8px !important;
        }

        .certificate-logo img {
            width: 150px;
        }

        .presented{
            margin-top: -30px !important;
            font-size: 10px !important;

        }

        .details{
            margin-top: -20px !important;
        }

        .item-valid-until{
            margin-top: 20px !important;
        }

        .item-cert-number{
            margin-top: 20px !important; 
        }

        .col-summary-section{
            margin-top: 30px;
        }
    }
</style>

<script>
    $(document).ready(function(){
        $("#GiftCard_Receiver").change(function(){
            $("#name-summary-text").html($(this).val());
        });
        $("#GiftCard_PhotoShootType").change(function(){
            $("#summary-photoshoot-type").html($(this).find(":selected").text());
            calculatePrice($(this).find(":selected").val());
        });
    });

    function calculatePrice(photoshootType, fuelPrice = 0) {
        if(photoshootType == "" || photoshootType == undefined){
            return;
        }

        console.log("Calculating price for photoshoot type: " + photoshootType + " and fuel price: " + fuelPrice);

         //let numberOfParticipants = $("#NumberOfParticipants").val();

        $.ajax({
            contentType: 'application/json',
            url: "@Url.Action("photoshootPrice", "Calculations")",
            traditional: true,
            method: "GET",
              data: { 'photoshootType': photoshootType, 'fuelPrice': fuelPrice, 'numberOfParticipants': 0 /*numberOfParticipants*/ },
            success: function (response) {
                if ($("#PhotoShootType").find(":selected").val() == 20 || $("#PhotoShootType").find(":selected").val() == 10) {
                    $("#price-summary").html("По договаряне");
                    $("#price-summary-euro").html("-");
                }
                else {
                    $("#price-summary").html('€ ' + response);
                    //$("#price-summary-euro").html('€ ' + convertBgnToEuro(response));
                }
            },
            error: function (response) {
                console.log("error");
                console.log(response);
            }
        });
    }
</script>